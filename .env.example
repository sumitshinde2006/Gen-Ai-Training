LLM_PROVIDER=groq
# Required for /chat, /ask, and RAG-backed agent answers. Leave blank for records/search/health.
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=
API_BASE_URL=http://127.0.0.1:8000

# Request and retrieval limits (the hard ceilings remain 1000 characters and top-k 20).
KANDAGUIDE_MAX_QUESTION_LENGTH=1000
KANDAGUIDE_MAX_TOP_K=20

# Process-local RAG response cache; it resets on process restart.
KANDAGUIDE_CACHE_ENABLED=true
KANDAGUIDE_CACHE_TTL_SECONDS=60
KANDAGUIDE_CACHE_MAX_ENTRIES=128
